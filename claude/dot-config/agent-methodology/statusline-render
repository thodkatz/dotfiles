#!/usr/bin/env bash
# Claude Code's status line, drawn: claude-powerline's boxes (directory, git, model, effort, the 5-hour and weekly
# usage: ../claude-powerline/config.json), then one of our own, joined onto its last one, which no segment of it
# can show: the context against the session budget.
# agent-methodology's statusline.sh runs this when it is executable (agent-methodology's settings set the status line
# to statusline.sh, so this is the way to restyle it): Claude Code's JSON on stdin, and in the environment what statusline.sh
# computed: AGENT_SL_PLAIN (its plain line), AGENT_SL_CTX and AGENT_SL_BUDGET (tokens). Without claude-powerline
# (README.md, *Claude Code's status line*), or its config, it prints the plain line.
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
input=$(cat)
plain() { [ -n "${AGENT_SL_PLAIN:-}" ] && printf '%s\n' "$AGENT_SL_PLAIN"; exit; }

cpl=$(command -v claude-powerline) || cpl=$HOME/.local/bin/claude-powerline
[ -x "$cpl" ] || plain
# Without its config claude-powerline draws its defaults (other boxes, other colours) and exits 0: the plain line
# is the better one then. Two arguments: it cuts --config=<path> at an = in the path. Its stderr is left alone:
# statusline.sh sends it where Claude Code's debug log gets it.
conf=$here/../claude-powerline/config.json
[ -r "$conf" ] || plain
pl=$("$cpl" --config "$conf" <<<"$input") && [ -n "$pl" ] || plain

# Gruvbox, as alacritty.toml and tmux.conf have it.
bg2="#504945" dark="#282828" green="#b8bb26" yellow="#fabd2f" red="#fb4934"
arrow=$'\xee\x82\xb0'   # U+E0B0, as bytes: \u would follow the locale
rgb() { local h=${1#\#}; printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

# Our boxes, as bg fg text triples.
ours=()
ctx=${AGENT_SL_CTX:-} budget=${AGENT_SL_BUDGET:-}
if [[ $ctx =~ ^[0-9]+$ && $budget =~ ^[1-9][0-9]*$ ]]; then
  ctx=$((10#$ctx))   # 08 is no octal number
  pct=$(( ctx * 100 / budget )) cells=$(( ctx * 10 / budget )) bar=""
  [ "$cells" -gt 10 ] && cells=10
  for ((i = 0; i < 10; i++)); do [ "$i" -lt "$cells" ] && bar+="█" || bar+="░"; done
  text="ctx $bar $((ctx / 1000))k/$((budget / 1000))k"
  if   [ "$pct" -ge 100 ]; then ours+=("$red" "$dark" "$text HAND OFF")
  elif [ "$pct" -ge 80 ];  then ours+=("$yellow" "$dark" "$text")
  else ours+=("$bg2" "$green" "$text"); fi
fi
[ ${#ours[@]} -eq 0 ] && { printf '%s\n' "$pl"; exit; }

# claude-powerline ends its line with a reset, an arrow in its last box's colour, a reset. Drop that arrow and start
# ours from that colour, so the boxes join; a line that ends otherwise (another style) gets ours after a space,
# with no arrow into the first.
csi=$'\e['
if [[ $pl =~ ^(.*)"${csi}0m${csi}38;2;"([0-9]+\;[0-9]+\;[0-9]+)"m$arrow${csi}0m"$ ]]; then
  out=${BASH_REMATCH[1]} prev=${BASH_REMATCH[2]}
else
  out="$pl " prev=""
fi
for ((i = 0; i < ${#ours[@]}; i += 3)); do
  b=$(rgb "${ours[i]}")
  out+="${csi}48;2;${b}m${prev:+${csi}38;2;${prev}m$arrow}${csi}38;2;$(rgb "${ours[i + 1]}")m ${ours[i + 2]} "
  prev=$b
done
printf '%s%s\n' "$out" "${csi}0m${csi}38;2;${prev}m$arrow${csi}0m"
