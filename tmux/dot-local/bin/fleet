#!/usr/bin/env bash
# fleet: one tmux session showing every agent session on the microVM guests of
# the hosts in ~/.config/fleet/hosts (or, with --local, of this host alone).
# Window `overview` has one pane per guest running its supervisor's status.sh;
# then one window per session running under dtach (named for its repo and
# branch, coloured for its host), its interactive pane attached over ssh. Syncs only when asked (prefix F, `fleet sync`); between
# syncs, the hint loop follows hops in the panes it has, in place.
# Design: docs/superpowers/specs/2026-11-05-tmux-fleet-design.md in dotfiles.
set -uo pipefail

FLEET_SELF=$(readlink -f "${BASH_SOURCE[0]}")
GUEST_USER=${AGENTVM_GUEST_USER:-agentvm}
STATE=${FLEET_STATE:-${XDG_RUNTIME_DIR:-/tmp}/fleet-$UID}
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5)
GUEST_SSH_OPTS=()   # set by guest_ssh_opts, once LOCAL is known
# The probes' and discovery's ssh share one connection per destination, kept
# FLEET_SSH_PERSIST (10m) after the last: a sync or a refresh then pays no
# handshake. Not the attach panes, which outlive any master and must not die
# with it. Off with FLEET_SSH_MUX=0, or when the socket's path would pass the
# 108 bytes a unix socket allows (%C is 40).
MUX_OPTS=()
if [ "${FLEET_SSH_MUX:-1}" != 0 ] && [ $(( ${#STATE} + 45 )) -lt 108 ]; then
  MUX_OPTS=(-o ControlMaster=auto -o "ControlPath=$STATE/ssh/%C" -o "ControlPersist=${FLEET_SSH_PERSIST:-10m}")
fi
mux_dir() { [ ${#MUX_OPTS[@]} = 0 ] || { mkdir -p "$STATE/ssh" && chmod 700 "$STATE/ssh"; }; }
LOCAL=0

die() { echo "fleet: $*" >&2; exit 1; }

# tmux on the fleet's server: FLEET_TMUX_SOCKET and FLEET_TMUX_CONF are for
# the tests, which run a private server with no config.
tmx() {
  local a=()
  [ -z "${FLEET_TMUX_SOCKET:-}" ] || a+=(-L "$FLEET_TMUX_SOCKET")
  [ -z "${FLEET_TMUX_CONF:-}" ] || a+=(-f "$FLEET_TMUX_CONF")
  tmux "${a[@]}" "$@"
}

# A command line for a pane: this script, its arguments quoted, with this
# run's --local and AGENTVM_KEY (a running server may not have the latter).
self_cmd() {
  [ -z "${AGENTVM_KEY:-}" ] || printf 'AGENTVM_KEY=%q ' "$AGENTVM_KEY"
  printf '%q ' "$FLEET_SELF"
  [ "$LOCAL" != 1 ] || printf -- '--local '
  printf '%q ' "$@"
}

# ssh options for a guest. Guests trust only their host's agentvm key, and
# their host keys are new to us: accept-new, and AGENTVM_KEY, else under
# --local the host's own key. No IdentitiesOnly: ~/.ssh/config and the agent
# still count (the laptop's way in).
guest_ssh_opts() {
  local k=${AGENTVM_KEY:-}
  GUEST_SSH_OPTS=("${SSH_OPTS[@]}" -o StrictHostKeyChecking=accept-new)
  [ -n "$k" ] || [ "$LOCAL" != 1 ] || [ ! -e "$HOME/.agentvm/keys/id_ed25519" ] || k=$HOME/.agentvm/keys/id_ed25519
  [ -z "$k" ] || GUEST_SSH_OPTS+=(-i "$k")
}

local_host() { echo "${FLEET_HOSTNAME:-$(uname -n)}"; }

default_session() { if [ "$LOCAL" = 1 ]; then echo "fleet-$(local_host)"; else echo fleet; fi; }

sdir() { echo "$STATE/$1"; }

hosts_file() { echo "${FLEET_HOSTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/fleet/hosts}"; }

# --- discovery -----------------------------------------------------------

# projects.json on stdin -> "host guest ip" lines.
projects_lines() { jq -r --arg h "$1" 'to_entries[] | "\($h) \(.value.vmName) \(.value.ip)"' 2>/dev/null; }

# Every guest, one "host guest ip" line each, in the hosts file's order. A host
# whose projects.json can't be read gives "host - -". The hosts are read at
# once: one after another, a host that is down held up every later one.
guests() {
  if [ "$LOCAL" = 1 ]; then
    projects_lines "$(local_host)" < "${AGENTVM_PROJECTS:-/etc/agentvm/projects.json}"
    return
  fi
  local f dest out tmp i=0
  f=$(hosts_file)
  [ -r "$f" ] || die "no hosts file $f (one ssh destination per line, e.g. theo@nixos), or use --local"
  mux_dir
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/fleet-guests.XXXXXX") || return 1
  while read -r dest; do
    case $dest in ''|'#'*) continue ;; esac
    i=$((i + 1))
    (
      if out=$(ssh "${MUX_OPTS[@]}" "${SSH_OPTS[@]}" "$dest" cat /etc/agentvm/projects.json </dev/null 2>/dev/null) && [ -n "$out" ]; then
        projects_lines "${dest#*@}" <<<"$out"
      else
        echo "${dest#*@} - -"
      fi > "$tmp/$(printf %04d "$i")"
    ) &
  done < "$f"
  wait
  cat "$tmp"/* 2>/dev/null
  rm -rf "$tmp"
}

# The script a guest runs (`bash -s -- json|table`): find the agent-supervise
# user unit's status.sh and AGENT_SUPERVISE_REPOS, then run it. Not `bash -l`:
# NixOS's /etc/profile resets PATH. json (discover) skips the forge calls, most
# of a run's time, for fields fleet doesn't read; --json comes first, as an older
# status.sh reads only $1 and ignores the rest.
probe_script() {
  cat <<'EOF'
mode=${1:-table}
unit=agent-supervise.service
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [ "$(systemctl --user show "$unit" -p LoadState --value 2>/dev/null)" != loaded ]; then
  echo fleet:no-supervisor; exit 0
fi
exec_start=$(systemctl --user show "$unit" -p ExecStart --value)
path=${exec_start#*path=}; path=${path%% *}
env=$(systemctl --user show "$unit" -p Environment --value)
# A value with spaces is quoted as a whole ("NAME=a b"); others are bare words.
envval() {
  local v
  v=$(sed -n "s/.*\"$1=\([^\"]*\)\".*/\1/p" <<<"$env")
  [ -n "$v" ] || v=$(tr ' ' '\n' <<<"$env" | sed -n "s/^$1=//p" | head -n 1)
  printf '%s' "$v"
}
status_sh=${path%/*}/status.sh
AGENT_SUPERVISE_REPOS=$(envval AGENT_SUPERVISE_REPOS) TMPDIR=$(envval TMPDIR) "$status_sh" $([ "$mode" = json ] && echo --json --no-forge)
EOF
}

# timeout: a hung status.sh must not hold up a sync.
probe() { mux_dir; probe_script | timeout "${FLEET_PROBE_TIMEOUT:-15}" ssh "${MUX_OPTS[@]}" "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$1" bash -s -- "$2" 2>/dev/null; }

# A guest's status.sh table, or why there is none.
status_of() {
  local out
  if [ -z "${2:-}" ] || [ "$2" = - ] || ! out=$(probe "$2" table); then echo unreachable; return; fi
  if [ "$out" = fleet:no-supervisor ]; then echo "no supervisor"; else printf '%s\n' "$out"; fi
}

# Probe every guest in parallel; write [{host, guest, ip, status, rows}] to $1
# atomically (sync and the hint loop may run at once). status: ok,
# unreachable, no-supervisor or error (status.sh printed no JSON array).
discover() {
  local out=$1 tmp i=0 h g ip
  mkdir -p "${out%/*}"
  tmp=$(mktemp -d "${out%/*}/.discover.XXXXXX")
  while read -r h g ip; do
    i=$((i + 1))
    (
      rows='[]' status=unreachable r=''
      if [ "$g" != - ] && r=$(probe "$ip" json); then
        if [ "$r" = fleet:no-supervisor ]; then status=no-supervisor
        elif jq -e 'type == "array"' >/dev/null 2>&1 <<<"$r"; then status=ok rows=$r
        else status=error; fi
      fi
      jq -n --arg host "$h" --arg guest "$g" --arg ip "$ip" --arg status "$status" --argjson rows "$rows" \
        '{host: $host, guest: $guest, ip: $ip, status: $status, rows: $rows}' > "$tmp/$(printf %04d "$i").json"
    ) &
  done < <(guests)
  wait
  local files=("$tmp"/*.json)
  if [ -e "${files[0]}" ]; then jq -s . "${files[@]}"; else echo '[]'; fi > "$tmp/fleet.json"
  mv -f "$tmp/fleet.json" "$out"
  rm -rf "$tmp"
}

# Attachable rows (continue starts with `dtach -a `), one tab-separated line
# each: entry host guest ip repo branch live sock. A missing field is `?`.
attachable() {
  jq -r 'def q: if . == null or . == "" then "?" else tostring end;
    .[] | . as $g | select(.status == "ok") | .rows[]
    | select((.continue // "") | startswith("dtach -a "))
    | [(.entry | q), $g.host, $g.guest, $g.ip, ((.repo // "") | split("/") | last | q),
       (.branch | q), (.live | q), (.continue | split(" ")[2])]
    | join("\t")' "$1"
}

# --- session -------------------------------------------------------------

# Point LOCAL at the mode the session was made in.
use_session() {
  local m
  m=$(tmx show -t "=$1:" -v @fleet-mode 2>/dev/null) || return 1
  if [ "$m" = local ]; then LOCAL=1; else LOCAL=0; fi
  guest_ssh_opts
}

# The session a sync or hint acts on: -t, else the current one, else the
# default; a session fleet did not make falls back to fleet or fleet-<host>.
# Called as $(...), so the caller runs use_session on the result.
target_session() {
  local s=${1:-}
  [ -n "$s" ] || [ -z "${TMUX:-}" ] || s=$(tmx display -p '#S' 2>/dev/null)
  [ -n "$s" ] || s=$(default_session)
  if use_session "$s"; then echo "$s"; return; fi
  for s in fleet "fleet-$(local_host)"; do
    if use_session "$s"; then echo "$s"; return; fi
  done
  return 1
}

# An agent's state by its live value: one narrow glyph and its gruvbox colour,
# which tmux draws, so it shows in colour with any font. agent-methodology's
# status.sh table uses the same glyphs.
live_look() {
  case $1 in
    alive) echo '● #b8bb26' ;; waiting) echo '○ #fabd2f' ;; stalled) echo '◐ #fabd2f' ;;
    blocked*) echo '◆ #d3869b' ;; dead*) echo '✗ #fb4934' ;; done) echo '✓ #928374' ;;
    gone) echo '∅ #928374' ;; *) echo '· #928374' ;;   # ended, - and ?
  esac
}

# A status.sh table in live_look's colours, for the overview: status.sh colours
# only on a tty, and over ssh its stdout is a pipe. Each row in its leading
# glyph's colour, the header bold, the rule and the supervisor line grey; a
# line already coloured, or not the table's (unreachable), passes through.
colour_table() {
  local v look hex line g
  declare -A rgb=()
  for v in alive waiting stalled blocked dead done gone ended; do
    look=$(live_look "$v"); hex=${look#* \#}
    rgb[${look% *}]="$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))"
  done
  local grey=${rgb[·]} n=0
  while IFS= read -r line; do
    n=$((n + 1)) g=${line:0:1}
    if [[ $line == *$'\033'* ]]; then printf '%s\n' "$line"
    elif [ $n = 1 ] && [[ $line == "  "* ]]; then printf '\033[1m%s\033[0m\n' "$line"
    elif [[ $line == "  ─"* || $line == "supervisor: "* ]]; then printf '\033[38;2;%sm%s\033[0m\n' "$grey" "$line"
    elif [ "${line:1:1}" = " " ] && [ -n "${rgb[$g]:-}" ]; then printf '\033[38;2;%sm%s\033[0m\n' "${rgb[$g]}" "$line"
    else printf '%s\n' "$line"; fi
  done
}

# A host's colour, by its place in fleet.json's sorted hosts: the tab colour
# of its windows and of its name in the hint.
HOST_COLOURS=('#8ec07c' '#fe8019' '#83a598' '#d3869b')
host_colours() {
  local h n
  while IFS=$'\t' read -r h n; do
    printf '%s\t%s\n' "$h" "${HOST_COLOURS[n % ${#HOST_COLOURS[@]}]}"
  done < <(jq -r 'map(.host) | unique | to_entries[] | "\(.value)\t\(.key)"' "$1")
}

# Tag an agent pane for tmux.conf's pane-border-format: its live state's glyph
# and colour, its branch and its live value.
tag_pane() {
  local look; look=$(live_look "$3")
  tmx set -p -t "$1" @fleet-glyph "${look% *}" \; set -p -t "$1" @fleet-colour "${look#* }" \; \
    set -p -t "$1" @fleet-branch "$2" \; set -p -t "$1" @fleet-live "$3" 2>/dev/null
}

# An agent window's name: its repo, a /, then what its session works on, its branch's last /-part
# (agent-methodology/accounts-view-2 for change/accounts-view-2), at most 24 characters; the repo alone when the
# branch is unknown. Not ·: the user asked for no · in tabs (the spec's Clarification 10), and a <host>·<repo> name is
# an older fleet's. The repo is also the window's @fleet-repo, which groups a repo's windows; the name fleet gave it
# is its @fleet-name.
win_label() {
  local b=${2##*/}
  case $2 in '' | '?') printf '%s\n' "$1"; return ;; esac
  [ -n "$b" ] || b=$2
  [ "${#b}" -le 24 ] || b=${b:0:23}…
  printf '%s/%s\n' "$1" "$b"
}

# Name each agent window for its repo and its first agent pane's branch (win_label), on every sync and tick, so a
# hop to another branch shows in the tab. A window a person renamed, its name no longer its @fleet-name, is left
# alone. A window from before @fleet-repo is fleet's when it is named for its pane's repo.
name_windows() {
  local s=$1 wid n r fn b entry want
  declare -A repo_of=() seen=()
  while IFS=$'\t' read -r entry r; do repo_of[$entry]=$r; done < <(jq -r '.[] | select(.status == "ok") | .rows[]?
    | [(.entry // ""), ((.repo // "") | split("/") | last)] | @tsv' "$(sdir "$s")/fleet.json" 2>/dev/null)
  # \037, as below: read would collapse a run of empty tab-separated options
  while IFS=$'\037' read -r wid n r fn b entry; do
    [ -n "$entry" ] && [ -z "${seen[$wid]:-}" ] || continue
    seen[$wid]=1
    if [ -z "$r" ]; then
      r=${repo_of[$entry]:-}
      [ -n "$r" ] && [ "$n" = "$r" ] || continue
      fn=$n
      tmx set -w -t "$wid" @fleet-repo "$r"
    fi
    [ "$n" = "$fn" ] || continue
    want=$(win_label "$r" "$b")
    [ "$want" != "$n" ] || continue
    tmx rename-window -t "$wid" "$want" \; set -w -t "$wid" @fleet-name "$want"
    SYNC_RENAMED=$((SYNC_RENAMED + 1))
  done < <(tmx list-panes -s -t "=$s" \
    -F $'#{window_id}\037#{window_name}\037#{@fleet-repo}\037#{@fleet-name}\037#{@fleet-branch}\037#{@fleet-entry}' 2>/dev/null)
}

# The guest a shell pane is ssh'd into, by its IP: the first ssh process at or under the pane's own, its
# destination's hostname as `ssh -G` resolves it (an alias in ~/.ssh/config too), one of fleet.json's guest IPs or
# names. ps, not /proc: macOS has no /proc. Nothing when the pane runs no ssh, or not to a guest.
pane_guest_ip() {
  local ssh_pid words host i
  ssh_pid=$(ps -A -o pid=,ppid=,comm= | awk -v root="$1" '
    { pid[NR] = $1; ppid[NR] = $2; n = split($3, c, "/"); comm[NR] = c[n] }
    END { under[root] = 1
      do { more = 0; for (i = 1; i <= NR; i++) if (under[ppid[i]] && !under[pid[i]]) { under[pid[i]] = 1; more = 1 } } while (more)
      for (i = 1; i <= NR; i++) if (under[pid[i]] && comm[i] == "ssh") { print pid[i]; exit } }')
  [ -n "$ssh_pid" ] || return 1
  # Its arguments after the word that ran it: `ssh ...`, or `bash /path/ssh ...` for a script named ssh
  read -ra words <<<"$(ps -o args= -p "$ssh_pid")"
  for ((i = 0; i < ${#words[@]}; i++)); do [ "${words[i]##*/}" != ssh ] || break; done
  [ "$i" -lt "${#words[@]}" ] || return 1
  host=$(ssh -G "${words[@]:i+1}" </dev/null 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')
  [ -n "$host" ] || return 1
  jq -er --arg h "$host" 'first(.[] | select(.guest != "-" and (.ip == $h or .guest == $h)) | .ip)' "$2"
}

# The overview window's layout: one row per guest, in pane order, its status pane on the left and its resources
# pane on the right, 72 columns wide (btop's cpu and mem boxes need 70; the status table up to 110, so it gets the
# rest, or half on a narrow window). tiled pairs them only for two guests, and tmux 3.8 changed the layout string's
# format, so it is built with commands: the resources panes out, the status panes stacked, each one joined back
# beside its own. tiled when the window holds a pane of neither kind (one made by hand).
overview_layout() {
  local w="=$1:overview" W pid g r l
  declare -A resof=()
  local st=()
  while IFS=$'\037' read -r pid g r; do   # not a tab: read collapses a run of them, and one field is empty
    if [ -n "$g" ]; then st+=("$pid $g"); elif [ -n "$r" ]; then resof[$r]=$pid
    else tmx select-layout -t "$w" tiled >/dev/null; return; fi
  done < <(tmx list-panes -t "$w" -F $'#{pane_id}\037#{@fleet-guest}\037#{@fleet-res-guest}')
  [ ${#st[@]} -gt 0 ] || return 0
  W=$(tmx display -p -t "$w" '#{window_width}')
  l=72; [ $(( W - 1 - l )) -ge 100 ] || l=$(( (W - 1) / 2 ))
  for r in "${resof[@]}"; do tmx break-pane -d -s "$r" >/dev/null; done
  tmx select-layout -t "$w" even-vertical >/dev/null
  for pid in "${st[@]}"; do
    r=${resof[${pid#* }]:-}
    [ -z "$r" ] || tmx join-pane -h -d -l "$l" -s "$r" -t "${pid%% *}" >/dev/null
  done
}

# Follow hops in the agent panes, in place: none is moved, added or closed (that waits for prefix F). A live pane
# whose entry is gone but whose socket is a live entry's (one chain.sh's next hop) is retagged onto it. An ended pane
# whose entry has a successor (an attachable row whose prev is its run id) on another socket that has no pane (a hop
# or a resume that got a new dtach) is respawned where it is, attached to it. A row without prev (an older
# status.sh) is no one's successor. Every pane of an attachable entry gets fresh tags. The hint loop's tick runs it,
# and so does each sync, first.
follow_panes() {
  local s=$1 json panes pid entry ended psock e ip sock branch live
  json=$(sdir "$s")/fleet.json
  SYNC_RETAGGED=0
  declare -A bysock=() sockof=() newrow=() byprev=() epaned=() spaned=()
  while IFS=$'\t' read -r entry _ _ ip _ branch live sock; do
    bysock["$ip $sock"]=$entry sockof[$entry]="$ip $sock" newrow[$entry]=$branch$'\t'$live
  done < <(attachable "$json")
  while IFS=$'\t' read -r ip e entry; do byprev["$ip $e"]=$entry; done < <(jq -r '.[] | . as $g | select(.status == "ok")
    | .rows[] | select((.prev // "") != "" and ((.continue // "") | startswith("dtach -a "))) | [$g.ip, .prev, .entry] | @tsv' "$json")
  panes=$(tmx list-panes -s -t "=$s" -F $'#{pane_id}\037#{@fleet-entry}\037#{@fleet-ended}\037#{@fleet-sock}' 2>/dev/null)
  while IFS=$'\037' read -r pid entry ended psock; do
    [ -z "$entry" ] || epaned[$entry]=1
    [ -z "$psock" ] || spaned[$psock]=$(( ${spaned[$psock]:-0} + 1 ))
  done <<<"$panes"
  while IFS=$'\037' read -r pid entry ended psock; do
    [ -n "$entry" ] && [ -n "$psock" ] || continue   # a pane made before @fleet-sock waits for a sync
    if [ "$ended" != 1 ]; then
      if [ -z "${newrow[$entry]:-}" ] && e=${bysock[$psock]:-} && [ -n "$e" ] && [ -z "${epaned[$e]:-}" ] &&
        [ "${spaned[$psock]}" = 1 ]; then
        tmx set -p -t "$pid" @fleet-entry "$e"; epaned[$e]=1 entry=$e SYNC_RETAGGED=$((SYNC_RETAGGED + 1))
      fi
      [ -z "${newrow[$entry]:-}" ] || tag_pane "$pid" "${newrow[$entry]%%$'\t'*}" "${newrow[$entry]#*$'\t'}"
      continue
    fi
    ip=${psock%% *} e=${byprev["${psock%% *} ${entry##*/}"]:-}
    [ -n "$e" ] && [ -z "${epaned[$e]:-}" ] && [ "${sockof[$e]}" != "$psock" ] && [ -z "${spaned[${sockof[$e]}]:-}" ] || continue
    sock=${sockof[$e]#* }
    # Unmarked first: an attach that ends at once marks it again.
    tmx set -p -u -t "$pid" @fleet-ended
    tmx respawn-pane -k -t "$pid" "$(self_cmd _attach "$ip" "$sock")" || { tmx set -p -t "$pid" @fleet-ended 1; continue; }
    tmx set -p -t "$pid" @fleet-entry "$e" \; set -p -t "$pid" @fleet-sock "$ip $sock" 2>/dev/null
    tag_pane "$pid" "${newrow[$e]%%$'\t'*}" "${newrow[$e]#*$'\t'}"
    epaned[$e]=1 spaned["$ip $sock"]=1 SYNC_RETAGGED=$((SYNC_RETAGGED + 1))
  done <<<"$panes"
  name_windows "$s"   # a hop's new branch in its tab
  return 0
}

# Lay the session out from its fleet.json; see the spec's *Sync*. $2: the pane prefix F was pressed in, which
# takes its guest's newest new session a person started (claudes -d) when it is a plain shell ssh'd into that guest.
sync_layout() {
  local s=$1 here=${2:-} d json g pid entry ended psock cmd e host guest ip repo branch live sock row wid have h n
  d=$(sdir "$s"); json=$d/fleet.json
  SYNC_ADDED=0 SYNC_CLOSED=0 SYNC_RENAMED=0 SYNC_HERE=0 SYNC_MOVED=0
  follow_panes "$s"   # sets SYNC_RETAGGED
  # att: the attachable entries; bysock: each one's entry by "<ip> <sock>", the dtach a pane attaches to. One
  # chain.sh runs every hop of a chain in the same dtach, each hop a new entry, so a pane follows its socket, and a
  # socket has one pane: a second would mirror the first, scrolling included.
  declare -A att=() paned=() bysock=() sockpaned=() newrow=() hcol=()
  while IFS=$'\t' read -r entry host guest ip repo branch live sock; do
    att[$entry]=1 bysock["$ip $sock"]=$entry newrow[$entry]=$branch$'\t'$live
  done < <(attachable "$json")
  while IFS=$'\t' read -r h n; do hcol[$h]=$n; done < <(host_colours "$json")

  # Overview: one pane per guest, its border tagged with the guest's host and that host's colour, on every sync
  # (a pane from before the tags gets them too).
  have=$(tmx list-panes -t "=$s:overview" -F '#{@fleet-guest}' 2>/dev/null)
  while IFS=$'\t' read -r g h; do
    if ! grep -qxF -- "$g" <<<"$have"; then
      pid=$(tmx split-window -d -t "=$s:overview" -P -F '#{pane_id}' "$(self_cmd _overview "$s" "$g")") || continue
      tmx set -p -t "$pid" @fleet-guest "$g" \; set -p -t "$pid" @fleet-overview 4
      tmx select-layout -t "=$s:overview" tiled >/dev/null
    fi
  done < <(jq -r '.[] | select(.guest != "-") | [.guest, .host] | join("\t")' "$json")
  # Beside each guest's status, to its right, its resources: btop over ssh (CPU, memory, disks), so a VM running
  # out of one shows. On every sync, so a fleet from before them gets them too; then one row per guest.
  local res added=0
  res=$(tmx list-panes -t "=$s:overview" -F '#{@fleet-res-guest}' 2>/dev/null)
  while IFS=$'\t' read -r pid g; do
    [ -n "$g" ] && ! grep -qxF -- "$g" <<<"$res" || continue
    pid=$(tmx split-window -h -d -t "$pid" -P -F '#{pane_id}' "$(self_cmd _resources "$s" "$g")") || continue
    tmx set -p -t "$pid" @fleet-res-guest "$g"; added=1
  done < <(tmx list-panes -t "=$s:overview" -F $'#{pane_id}\t#{@fleet-guest}' 2>/dev/null)
  [ "$added" = 0 ] || overview_layout "$s"
  while IFS=$'\t' read -r pid g v; do
    [ -n "$g" ] || { g=$(tmx display -p -t "$pid" '#{@fleet-res-guest}') && [ -n "$g" ] || continue; v=4; }
    h=$(jq -r --arg g "$g" 'first(.[] | select(.guest == $g) | .host) // ""' "$json")
    tmx set -p -t "$pid" @fleet-guest-host "$h" \; set -p -t "$pid" @fleet-guest-colour "${hcol[$h]:-#ebdbb2}" 2>/dev/null
    # A pane started by an older fleet runs that fleet's loop, which a pull does not change: restart it.
    [ "$v" = 4 ] || tmx respawn-pane -k -t "$pid" "$(self_cmd _overview "$s" "$g")" \; set -p -t "$pid" @fleet-overview 4
  done < <(tmx list-panes -t "=$s:overview" -F $'#{pane_id}\t#{@fleet-guest}\t#{@fleet-overview}' 2>/dev/null)

  # A window made before the host tags, named <host>·<repo>: tagged with its host and repo, its name fleet's, so
  # name_windows below renames it, whether or not this sync adds a pane to it (prefix r alone leaves it as it was).
  while IFS=$'\t' read -r wid n; do
    h=${n%%·*}
    [ "$h" != "$n" ] && [ -n "${hcol[$h]:-}" ] || continue
    tmx set -w -t "$wid" @fleet-host "$h" \; set -w -t "$wid" @fleet-host-colour "${hcol[$h]}" \; \
      set -w -t "$wid" @fleet-repo "${n#*·}" \; set -w -t "$wid" @fleet-name "$n"
  done < <(tmx list-windows -t "=$s" -F $'#{window_id}\t#{window_name}\t#{@fleet-host}' | awk -F '\t' '$3 == "" { print $1 "\t" $2 }')
  # Tagged agent panes.
  # \037, not a tab: read collapses runs of whitespace, and an empty @fleet-ended would shift @fleet-sock into it
  while IFS=$'\037' read -r pid entry ended psock cmd; do
    [ -n "$entry" ] || continue
    # A pane made before @fleet-sock: its socket is the last two words of its `_attach <ip> <sock>` command.
    if [ -z "$psock" ] && psock=$(awk '{ gsub(/"/, ""); for (i = 1; i < NF - 1; i++) if ($i == "_attach") { print $(i + 1), $(i + 2); exit } }' <<<"$cmd") &&
      [ -n "$psock" ]; then
      tmx set -p -t "$pid" @fleet-sock "$psock"
    fi
    # A hop: the pane's entry is gone, but its socket is a live entry's. Same attach, retag it.
    if [ -z "${att[$entry]:-}" ] && [ "$ended" != 1 ] && [ -n "$psock" ] && e=${bysock[$psock]:-} && [ -n "$e" ]; then
      if [ -z "${paned[$e]:-}" ] && [ -z "${sockpaned[$psock]:-}" ]; then
        tmx set -p -t "$pid" @fleet-entry "$e"   # its title follows below, as any attachable entry's
        SYNC_RETAGGED=$((SYNC_RETAGGED + 1))
      fi
      entry=$e
    fi
    if [ "$ended" = 1 ]; then
      # Its attach has ended: closed, whether its entry is attachable (a fresh attach replaces it below), blocked,
      # stopped or gone. The overview still shows the entry's state.
      tmx kill-pane -t "$pid"; SYNC_CLOSED=$((SYNC_CLOSED + 1)); continue
    fi
    if [ -n "${att[$entry]:-}" ]; then
      if [ -n "${paned[$entry]:-}" ] || { [ -n "$psock" ] && [ -n "${sockpaned[$psock]:-}" ]; }; then
        tmx kill-pane -t "$pid"; SYNC_CLOSED=$((SYNC_CLOSED + 1)); continue   # a second pane on one dtach
      fi
      # Still attachable: refresh its tags, its live (and glyph) may have changed since the last sync.
      paned[$entry]=1; [ -z "$psock" ] || sockpaned[$psock]=1
      tag_pane "$pid" "${newrow[$entry]%%$'\t'*}" "${newrow[$entry]#*$'\t'}"
      continue
    fi
    row=$(jq -r --arg e "$entry" 'def q: if . == null or . == "" then "?" else tostring end;
      first(.[] | .rows[]? | select(.entry == $e) | [(.branch | q), (.live | q)] | join("\t")) // empty' "$json")
    if [ -n "$row" ]; then                                                # a live attach, now blocked or stopped
      tag_pane "$pid" "${row%%$'\t'*}" "${row#*$'\t'}"
    fi
  done < <(tmx list-panes -s -t "=$s" -F $'#{pane_id}\037#{@fleet-entry}\037#{@fleet-ended}\037#{@fleet-sock}\037#{pane_start_command}')

  # The pane prefix F was pressed in: a person opened it, ssh'd into a guest and ran `claudes -d` there. When it is
  # a plain shell in this session (no agent or overview pane), it becomes that session's pane, in place of the shell,
  # rather than a new one beside it to switch to while this one is closed by hand. The session: the guest's newest
  # attended (unattended 0) attachable entry with no pane, never the supervisor's unattended ones.
  local here_s here_tags
  if [ -n "$here" ] && IFS=$'\037' read -r here_s here_tags pid < <(tmx display -p -t "$here" \
      $'#{session_name}\037#{@fleet-entry}#{@fleet-guest}\037#{pane_pid}' 2>/dev/null) &&
    [ "$here_s" = "$s" ] && [ -z "$here_tags" ] && ip=$(pane_guest_ip "$pid" "$json"); then
    while IFS=$'\t' read -r entry sock host repo; do
      [ -z "${paned[$entry]:-}" ] && [ -z "${sockpaned["$ip $sock"]:-}" ] || continue
      tmx respawn-pane -k -t "$here" "$(self_cmd _attach "$ip" "$sock")" || break
      paned[$entry]=1 sockpaned["$ip $sock"]=1 SYNC_HERE=1
      tmx set -p -t "$here" @fleet-entry "$entry" \; set -p -t "$here" @fleet-sock "$ip $sock" 2>/dev/null
      tag_pane "$here" "${newrow[$entry]%%$'\t'*}" "${newrow[$entry]#*$'\t'}"
      # alone in its window (prefix c's), the window is named and tagged as a new one's: for its repo and branch, with
      # its host; a pane split into another window leaves that window's name
      if [ "$(tmx display -p -t "$here" '#{window_panes}')" = 1 ]; then
        n=$(win_label "$repo" "${newrow[$entry]%%$'\t'*}")
        tmx rename-window -t "$here" "$n" \; set -w -t "$here" @fleet-host "$host" \; \
          set -w -t "$here" @fleet-host-colour "${hcol[$host]:-}" \; set -w -t "$here" @fleet-repo "$repo" \; \
          set -w -t "$here" @fleet-name "$n" 2>/dev/null
      fi
      break
    done < <(jq -r --arg ip "$ip" 'def q: if . == null or . == "" then "?" else tostring end;
      .[] | . as $g | select(.ip == $ip and .status == "ok") | .rows[]
      | select(.unattended == 0 and ((.continue // "") | startswith("dtach -a ")))
      | [(.started // "0" | tostring), .entry, (.continue | split(" ")[2]), $g.host, ((.repo // "") | split("/") | last | q)]
      | @tsv' "$json" | sort -t $'\t' -k1,1nr | cut -f 2-)
  fi

  # A window for each attachable entry that has no pane, on a socket that has none, by host then repo: named for its
  # repo and branch and tagged with its host and repo, right after that host's last window for the repo (its
  # @fleet-repo; the name of one from before it), so a repo's sessions sit together.
  while IFS=$'\t' read -r entry host guest ip repo branch live sock; do
    [ -z "${paned[$entry]:-}" ] && [ -z "${sockpaned["$ip $sock"]:-}" ] || continue
    sockpaned["$ip $sock"]=1
    wid=$(tmx list-windows -t "=$s" -F $'#{window_id}\037#{@fleet-host}\037#{@fleet-repo}\037#{window_name}' |
      awk -F '\037' -v h="$host" -v r="$repo" '$2 == h && ($3 == r || ($3 == "" && $4 == r)) { id = $1 } END { print id }')
    n=$(win_label "$repo" "$branch")
    if [ -n "$wid" ]; then
      pid=$(tmx new-window -d -a -t "$wid" -n "$n" -P -F '#{pane_id}' "$(self_cmd _attach "$ip" "$sock")") || continue
    else
      pid=$(tmx new-window -d -t "=$s:" -n "$n" -P -F '#{pane_id}' "$(self_cmd _attach "$ip" "$sock")") || continue
    fi
    tmx set -w -t "$pid" @fleet-host "$host" \; set -w -t "$pid" @fleet-host-colour "${hcol[$host]:-}" \; \
      set -w -t "$pid" @fleet-repo "$repo" \; set -w -t "$pid" @fleet-name "$n"
    SYNC_ADDED=$((SYNC_ADDED + 1))
    tmx set -p -t "$pid" @fleet-entry "$entry" 2>/dev/null
    tag_pane "$pid" "$branch" "$live"
    tmx set -p -t "$pid" @fleet-sock "$ip $sock" 2>/dev/null
  done < <(attachable "$json" | sort -t $'\t' -k2,2 -k5,5)
  split_windows "$s"
  name_windows "$s"
}

# One agent pane per window: a window from before (a repo's sessions tiled in one) keeps its first agent pane, and
# each other one moves to a window of its own right after it, with its host and repo tags, named for its repo and
# its own branch. A pane that isn't an agent's (a shell opened by hand) stays where it is.
split_windows() {
  local s=$1 wid pid n h c r b prev='' dst='' new
  while IFS=$'\037' read -r wid pid n h c r b; do
    # the window's first agent pane stays; the others go after it, in pane order
    if [ "$wid" != "$prev" ]; then prev=$wid dst=$wid; continue; fi
    r=${r:-$n}; n=$(win_label "$r" "$b")
    new=$(tmx break-pane -d -a -s "$pid" -t "$dst" -n "$n" -P -F '#{window_id}') || continue
    dst=$new
    tmx set -w -t "$new" @fleet-host "$h" \; set -w -t "$new" @fleet-host-colour "$c" \; \
      set -w -t "$new" @fleet-repo "$r" \; set -w -t "$new" @fleet-name "$n"
    SYNC_MOVED=$((SYNC_MOVED + 1))
  done < <(tmx list-panes -s -t "=$s" -F $'#{window_id}\037#{pane_id}\037#{window_name}\037#{@fleet-host}\037#{@fleet-host-colour}\037#{@fleet-repo}\037#{@fleet-branch}\037#{@fleet-entry}' |
    awk -F '\037' '$8 != ""' | cut -d $'\037' -f 1-7)
}

# --- hint ----------------------------------------------------------------

# Write <state>/<s>/hint from its fleet.json, in tmux styles for status-right:
# per host its name in its colour, `●N` live sessions and `◆M` sessions needing
# you (stalled or blocked; left out at 0) or `✗` when unreachable, then `↻K`
# for attachable entries with no pane.
hint_write() {
  local s=$1 d k entry psock ip sock tmp
  d=$(sdir "$s")
  declare -A paned=()
  # A pane counts for its entry and for its socket: after a hop, the next sync retags it with the new entry.
  while IFS=$'\037' read -r entry psock; do
    [ -z "$entry" ] || paned[$entry]=1
    [ -z "$psock" ] || paned["$psock"]=1
  done < <(tmx list-panes -s -t "=$s" -F $'#{@fleet-entry}\037#{@fleet-sock}' 2>/dev/null)
  k=0
  while IFS=$'\t' read -r entry _ _ ip _ _ _ sock; do
    [ -n "${paned[$entry]:-}" ] || [ -n "${paned["$ip $sock"]:-}" ] || k=$((k + 1))
  done < <(attachable "$d/fleet.json")
  tmp=$(mktemp "$d/.hint.XXXXXX") || return 1   # the loop and a sync may write at once
  jq -r --argjson k "$k" --argjson c "$(host_colours "$d/fleet.json" | jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}')" '
    group_by(.host) | map(.[0].host as $h | "#[fg=\($c[$h] // "default")]\($h)#[default] "
      + if all(.[]; .status != "ok") then "#[fg=#fb4934]✗#[default]"
        else [.[] | select(.status == "ok") | .rows[]] as $r
          | ([$r[] | select((.kind // "") != "" or .state == "blocked")] | length) as $m
          | "#[fg=#b8bb26]●\([$r[] | select(.live == "alive" and (.kind // "") == "")] | length)#[default]"
            + if $m > 0 then " #[fg=#d3869b]◆\($m)#[default]" else "" end
        end)
    | join("  ") + (if $k > 0 then "  #[fg=#928374]↻\($k)#[default]" else "" end)' "$d/fleet.json" > "$tmp" && mv -f "$tmp" "$d/hint"
  rm -f "$tmp"
}

hint_refresh() { discover "$(sdir "$1")/fleet.json" && hint_write "$1"; }

# The hint loop's tick: rediscover, follow hops in the panes (follow_panes), rewrite the hint. Discovery runs outside
# the sync lock, as hint --refresh's does, so that a prefix F pressed meanwhile is not turned away; following runs
# under it, so it never races a sync's layout. A sync that holds it does the following itself.
cmd__tick() {
  local s=$1
  use_session "$s" || return 0
  discover "$(sdir "$s")/fleet.json" || return 0
  (
    flock -n 9 || exit 0
    follow_panes "$s"
  ) 9>"$(sdir "$s")/sync.lock"
  hint_write "$s"
}

# --- commands ------------------------------------------------------------

cmd_up() {
  local s pid first
  s=$(default_session)
  if tmx has-session -t "=$s" 2>/dev/null; then
    # The marker lives as long as the server: a session without it was
    # restored by resurrect into a new server, untagged, so rebuild it.
    [ "$(tmx show -gv "@fleet-booted-$s" 2>/dev/null)" = 1 ] && return 0
    tmx kill-session -t "=$s"
  fi
  echo "fleet: discovering guests..." >&2
  discover "$(sdir "$s")/fleet.json"
  first=$(jq -r '[.[] | select(.guest != "-")][0].guest // "-"' "$(sdir "$s")/fleet.json")
  pid=$(tmx new-session -d -s "$s" -n overview -x 200 -y 50 -P -F '#{pane_id}' "$(self_cmd _overview "$s" "$first")") \
    || die "could not start tmux session $s"
  tmx set -p -t "$pid" @fleet-guest "$first" \; set -p -t "$pid" @fleet-overview 4
  if [ "$LOCAL" = 1 ]; then tmx set -t "=$s:" @fleet-mode local; else tmx set -t "=$s:" @fleet-mode remote; fi
  tmx set -g "@fleet-booted-$s" 1
  [ -n "${FLEET_NO_HINTLOOP:-}" ] || tmx run-shell -b "$(self_cmd _hintloop "$s")"
  sync_layout "$s"
  hint_write "$s"
}

cmd_sync() {
  local s t='' here=''
  while [ $# -gt 0 ]; do
    case $1 in -t) t=${2:-}; shift ;; -p) here=${2:-}; shift ;; esac
    shift
  done
  s=$(target_session "$t") || die "no fleet session; start one with: fleet"
  use_session "$s"   # target_session ran in a subshell
  # One sync at a time per session: two would both add the same panes.
  mkdir -p "$(sdir "$s")"
  exec 9>"$(sdir "$s")/sync.lock"
  flock -n 9 || { echo "fleet: a sync of $s is already running" >&2; exit 0; }
  discover "$(sdir "$s")/fleet.json"
  sync_layout "$s" "$here"
  hint_write "$s"
  # A hint loop an older fleet started keeps that fleet's code, and its look, until it dies: replace it.
  local pidf p v; pidf=$(sdir "$s")/hintloop.pid
  if [ -z "${FLEET_NO_HINTLOOP:-}" ] && [ -r "$pidf" ] && read -r p v <"$pidf" && [ "${v:-}" != 5 ]; then
    kill "$p" 2>/dev/null; rm -f "$pidf"
    tmx run-shell -b "$(self_cmd _hintloop "$s")"
  fi
  # Prefix F shows this line: a sync can take a while, and without it one that changed nothing looks like none ran.
  local did=()
  [ "$SYNC_HERE" = 0 ] || did+=("1 attached in this pane")
  [ "$SYNC_ADDED" = 0 ] || did+=("$SYNC_ADDED added")
  [ "$SYNC_CLOSED" = 0 ] || did+=("$SYNC_CLOSED closed")
  [ "$SYNC_RETAGGED" = 0 ] || did+=("$SYNC_RETAGGED followed a hop")
  [ "$SYNC_RENAMED" = 0 ] || did+=("$SYNC_RENAMED renamed")
  [ "$SYNC_MOVED" = 0 ] || did+=("$SYNC_MOVED moved to a window of its own")
  if [ ${#did[@]} = 0 ]; then echo "fleet: synced $s, nothing to change"
  else local line; printf -v line '%s, ' "${did[@]}"; echo "fleet: synced $s: ${line%, }"; fi
}

cmd_hint() {
  local t='' refresh=0 s
  while [ $# -gt 0 ]; do
    case $1 in -t) t=${2:-}; shift ;; --refresh) refresh=1 ;; esac
    shift
  done
  if [ "$refresh" = 1 ]; then
    s=$(target_session "$t") || exit 0
    use_session "$s"
    hint_refresh "$s"
  fi
  [ -n "$t" ] && hint_cat "$t" && exit 0
  for s in fleet "fleet-$(local_host)"; do hint_cat "$s" && exit 0; done
  exit 0
}

# A session's cached hint, only while that session exists (a cache outlives
# its session when the loop is killed with the server).
hint_cat() { tmx has-session -t "=$1" 2>/dev/null && [ -r "$(sdir "$1")/hint" ] && cat "$(sdir "$1")/hint"; }

cmd_doctor() {
  local fail=0 c dest h g ip err
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  for c in tmux jq ssh fzf; do
    if command -v "$c" >/dev/null; then ok "$c"; else bad "$c not on PATH"; fi
  done
  if [ "$LOCAL" = 0 ]; then
    if [ -r "$(hosts_file)" ]; then
      while read -r dest; do
        case $dest in ''|'#'*) continue ;; esac
        if ssh "${SSH_OPTS[@]}" "$dest" true </dev/null >/dev/null 2>&1; then ok "ssh $dest"; else bad "ssh $dest"; fi
      done < "$(hosts_file)"
    else
      bad "no hosts file $(hosts_file)"
    fi
  fi
  while read -r h g ip; do
    [ "$g" != - ] || continue
    if [ "$LOCAL" = 0 ]; then
      if ip route get "$ip" 2>/dev/null | grep -q tailscale; then ok "route to $ip via tailscale"
      else bad "no tailnet route to $ip ($g on $h): tailscale up --accept-routes"; fi
    fi
    if err=$(ssh "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" command -v dtach </dev/null 2>&1 >/dev/null); then ok "ssh $GUEST_USER@$ip ($g): dtach"
    else
      bad "ssh $GUEST_USER@$ip ($g): no ssh, or no dtach there"
      [ -z "$err" ] || echo "      $(tail -n 1 <<<"$err")"   # ssh's own reason
    fi
  done < <(guests)
  return "$fail"
}

cmd_status() {
  local h g ip
  # shellcheck disable=SC2034 # h (the host column) is unused here
  while read -r h g ip; do
    [ "$g" = "$1" ] && { status_of "$g" "$ip"; return 0; }
  done < <(guests)
  die "no guest $1"
}

# Pane command: attach to one session's dtach. C-] detaches (the pane closes,
# the agent runs on); when the session itself ends or the link is lost (ssh
# exits 255), the pane stays, marked @fleet-ended, until the next sync, which
# closes it or, if the entry is still attachable, attaches afresh; or, when its
# session handed over to a successor on a new socket, until the hint loop's next
# tick respawns it attached to that. -r ctrl_l, not winch: an attach at the
# size the session already has sends a SIGWINCH Claude Code draws nothing for,
# so a pane on an idle session stayed black (2026-11-07); ^L redraws it.
cmd__attach() {
  local ip=$1 sock=$2 rc
  ssh -t "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" "dtach -a $(printf %q "$sock") -e '^]' -r ctrl_l"
  rc=$?
  # shellcheck disable=SC2029  # $sock is quoted here on purpose, for the remote shell
  if [ "$rc" != 255 ] && ssh "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" "test -S $(printf %q "$sock")" </dev/null 2>/dev/null; then exit 0; fi
  tmx set -p -t "${TMUX_PANE:-}" @fleet-ended 1
  if [ "$rc" = 255 ]; then echo "[fleet] link lost; prefix F syncs"; else echo "[fleet] session ended; prefix F syncs"; fi
  exec tail -f /dev/null
}

# Pane command: one guest's status, every FLEET_OVERVIEW_INTERVAL seconds.
cmd__overview() {
  local s=$1 g=$2 ip out
  while :; do
    ip=$(jq -r --arg g "$g" 'first(.[] | select(.guest == $g) | .ip) // "-"' "$(sdir "$s")/fleet.json" 2>/dev/null)
    out=$(status_of "$g" "$ip")
    # The border (tmux.conf) says which guest; this is its live count, what needs you, and when.
    tmx set -p -t "${TMUX_PANE:-}" @fleet-summary "$(jq -r --arg g "$g" '
      [.[] | select(.guest == $g)][0] // {} | if .status != "ok" then "#[fg=#fb4934]✗ \(.status // "unknown")"
      else [.rows[]?] as $r | ([$r[] | select((.kind // "") != "" or .state == "blocked")] | length) as $m
        | "#[fg=#b8bb26]●\([$r[] | select(.live == "alive" and (.kind // "") == "")] | length)"
          + if $m > 0 then " #[fg=#d3869b]◆\($m)" else "" end end' "$(sdir "$s")/fleet.json" 2>/dev/null)  #[fg=#928374]$ip $(date +%H:%M)" 2>/dev/null
    clear
    colour_table <<<"$out"
    sleep "${FLEET_OVERVIEW_INTERVAL:-15}"
  done
}

# Pane command: one guest's resources, btop over ssh (htop where a guest has no btop): CPU, memory and disks.
# Again after it exits or the link drops.
cmd__resources() {
  local s=$1 g=$2 ip
  while :; do
    ip=$(jq -r --arg g "$g" 'first(.[] | select(.guest == $g) | .ip) // "-"' "$(sdir "$s")/fleet.json" 2>/dev/null)
    if [ -n "$ip" ] && [ "$ip" != - ]; then
      # btop's cpu and mem (with disks) boxes only: all four need 80x24, more than a pane has beside a status
      ssh -t "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" 'if command -v btop >/dev/null; then c=${TMPDIR:-/tmp}/fleet-btop.conf
        btop --default-config | sed "s/^shown_boxes = .*/shown_boxes = \"cpu mem\"/" > "$c" && exec btop -c "$c"; fi; exec htop'
    fi
    clear; echo "[fleet] $g's resources: no link; again in 15 s"
    sleep 15
  done
}

# Background (run-shell -b): while the session lives, refresh the hint and follow hops in the panes (cmd__tick).
cmd__hintloop() {
  local s=$1 pidf p
  pidf=$(sdir "$s")/hintloop.pid
  mkdir -p "$(sdir "$s")"
  if [ -r "$pidf" ] && read -r p _ <"$pidf" && kill -0 "$p" 2>/dev/null; then return 0; fi
  echo "$$ 5" > "$pidf"   # 5: this loop ticks the fleet on disk, every FLEET_HINT_INTERVAL (20 s); sync replaces any other
  # Killed (sync's replace, a HUP), exit 0: run-shell -b prints a job that dies of a signal into the active pane.
  # The pid file only if still ours: a successor sync started may have written its own.
  local slp=''
  trap '[ -z "$slp" ] || kill "$slp" 2>/dev/null; read -r p _ <"$pidf" 2>/dev/null && [ "$p" = $$ ] && rm -f "$pidf"; exit 0' HUP TERM INT
  use_session "$s" || return 0
  while tmx has-session -t "=$s" 2>/dev/null; do
    # The fleet on disk, not this process's copy: after a pull the hint takes the new look without a restart.
    bash -c "$(self_cmd _tick "$s")" >/dev/null 2>&1
    # In the background and waited for, so a signal runs the trap now, not after the sleep.
    sleep "${FLEET_HINT_INTERVAL:-20}" & slp=$!
    wait "$slp"; slp=''
  done
  rm -f "$pidf" "$(sdir "$s")/hint"
}

usage() {
  cat <<'EOF'
usage: fleet [--local] [command]

  (none)        start the fleet session if needed, then attach or switch to it
  up            start the fleet session if needed (no attach)
  sync [-t s] [-p pane]   rediscover and add/close agent panes (prefix F); -p: a
                shell pane ssh'd into a guest attaches to the session started
                there with `claudes -d`, instead of a new pane
  ls            list guests: host guest ip
  status GUEST  that guest's status.sh table, or unreachable / no supervisor
  hint [-t s] [--refresh]   the status-bar hint (cached; --refresh rediscovers)
  doctor        check each prerequisite, name the one that fails
  help          this text

--local: this host's guests only (/etc/agentvm/projects.json), session fleet-<host>.
Hosts: ~/.config/fleet/hosts, one ssh destination per line (theo@nixos).
In an agent pane, C-] detaches: the pane closes, the agent keeps running.
EOF
}

main() {
  if [ "${1:-}" = --local ]; then LOCAL=1; shift; fi
  guest_ssh_opts
  local cmd=${1:-attach}
  [ $# -eq 0 ] || shift
  case $cmd in
    attach)
      cmd_up || exit 1
      if [ -n "${TMUX:-}" ]; then tmx switch-client -t "=$(default_session)"
      else exec tmux ${FLEET_TMUX_SOCKET:+-L "$FLEET_TMUX_SOCKET"} attach -t "=$(default_session)"; fi ;;
    up) cmd_up ;;
    sync) cmd_sync "$@" ;;
    hint) cmd_hint "$@" ;;
    _overview) cmd__overview "$@" ;;
    _resources) cmd__resources "$@" ;;
    _colour) colour_table ;;
    _attach) cmd__attach "$@" ;;
    _hintloop) cmd__hintloop "$@" ;;
    _tick) cmd__tick "$@" ;;
    ls) guests ;;
    status) [ $# -ge 1 ] || die "usage: fleet status GUEST"; cmd_status "$1" ;;
    doctor) cmd_doctor ;;
    help|-h|--help) usage ;;
    _probe-script) probe_script ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
