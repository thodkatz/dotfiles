#!/usr/bin/env bash
# fleet: the agent sessions on the microVM guests of the hosts in ~/.config/fleet/hosts (or, with --local, of this
# host alone), each guest's own `agents` tmux session (workmux's window per agent, and a `dashboard` window) attached
# over ssh: straight from this terminal when there is one guest, else a tmux session with a window per guest.
# Design: docs/fleet-design.md in dotfiles.
set -uo pipefail

FLEET_SELF=$(readlink -f "${BASH_SOURCE[0]}")
GUEST_USER=${AGENTVM_GUEST_USER:-agentvm}
STATE=${FLEET_STATE:-${XDG_RUNTIME_DIR:-/tmp}/fleet-$UID}
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5)
GUEST_SSH_OPTS=()   # set by guest_ssh_opts, once LOCAL is known
# Discovery's ssh to the hosts shares one connection per destination, kept
# FLEET_SSH_PERSIST (10m) after the last: a pane that looks its guest up again
# then pays no handshake. Not the attach, which outlives any master and must
# not die with it. Off with FLEET_SSH_MUX=0, or when the socket's path would
# pass the 108 bytes a unix socket allows (%C is 40).
MUX_OPTS=()
if [ "${FLEET_SSH_MUX:-1}" != 0 ] && [ $(( ${#STATE} + 45 )) -lt 108 ]; then
  MUX_OPTS=(-o ControlMaster=auto -o "ControlPath=$STATE/ssh/%C" -o "ControlPersist=${FLEET_SSH_PERSIST:-10m}")
fi
mux_dir() { [ ${#MUX_OPTS[@]} = 0 ] || { mkdir -p "$STATE/ssh" && chmod 700 "$STATE/ssh"; }; }
LOCAL=0
# The layout this fleet builds, @fleet-booted-<session>'s value: `fleet` rebuilds a session another one built (an
# older fleet's overview) or resurrect restored (no marker).
LAYOUT=e

die() { echo "fleet: $*" >&2; exit 1; }

# tmux on the fleet's server: FLEET_TMUX_SOCKET and FLEET_TMUX_CONF are for
# the tests, which run a private server with no config.
tmx() {
  local a=()
  [ -z "${FLEET_TMUX_SOCKET:-}" ] || a+=(-L "$FLEET_TMUX_SOCKET")
  [ -z "${FLEET_TMUX_CONF:-}" ] || a+=(-f "$FLEET_TMUX_CONF")
  tmux "${a[@]}" "$@"
}

# A command line for a pane: this script, its arguments quoted, with this
# run's --local and AGENTVM_KEY (a running server may not have the latter).
self_cmd() {
  [ -z "${AGENTVM_KEY:-}" ] || printf 'AGENTVM_KEY=%q ' "$AGENTVM_KEY"
  printf '%q ' "$FLEET_SELF"
  [ "$LOCAL" != 1 ] || printf -- '--local '
  printf '%q ' "$@"
}

# ssh options for a guest. Guests trust only their host's agentvm key, and
# their host keys are new to us: accept-new, and AGENTVM_KEY, else under
# --local the host's own key. No IdentitiesOnly: ~/.ssh/config and the agent
# still count (the laptop's way in).
guest_ssh_opts() {
  local k=${AGENTVM_KEY:-}
  GUEST_SSH_OPTS=("${SSH_OPTS[@]}" -o StrictHostKeyChecking=accept-new)
  [ -n "$k" ] || [ "$LOCAL" != 1 ] || [ ! -e "$HOME/.agentvm/keys/id_ed25519" ] || k=$HOME/.agentvm/keys/id_ed25519
  [ -z "$k" ] || GUEST_SSH_OPTS+=(-i "$k")
}

local_host() { echo "${FLEET_HOSTNAME:-$(uname -n)}"; }

default_session() { if [ "$LOCAL" = 1 ]; then echo "fleet-$(local_host)"; else echo fleet; fi; }

hosts_file() { echo "${FLEET_HOSTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/fleet/hosts}"; }

# --- discovery -----------------------------------------------------------

# projects.json on stdin -> "host guest ip" lines.
projects_lines() { jq -r --arg h "$1" 'to_entries[] | "\($h) \(.value.vmName) \(.value.ip)"' 2>/dev/null; }

# Every guest, one "host guest ip" line each, in the hosts file's order. A host
# whose projects.json can't be read gives "host - -". The hosts are read at
# once: one after another, a host that is down held up every later one.
guests() {
  if [ "$LOCAL" = 1 ]; then
    projects_lines "$(local_host)" < "${AGENTVM_PROJECTS:-/etc/agentvm/projects.json}"
    return
  fi
  local f dest out tmp i=0
  f=$(hosts_file)
  [ -r "$f" ] || die "no hosts file $f (one ssh destination per line, e.g. theo@nixos), or use --local"
  mux_dir
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/fleet-guests.XXXXXX") || return 1
  while read -r dest; do
    case $dest in ''|'#'*) continue ;; esac
    i=$((i + 1))
    (
      if out=$(ssh "${MUX_OPTS[@]}" "${SSH_OPTS[@]}" "$dest" cat /etc/agentvm/projects.json </dev/null 2>/dev/null) && [ -n "$out" ]; then
        projects_lines "${dest#*@}" <<<"$out"
      else
        echo "${dest#*@} - -"
      fi > "$tmp/$(printf %04d "$i")"
    ) &
  done < "$f"
  wait
  cat "$tmp"/* 2>/dev/null
  rm -rf "$tmp"
}

# --- the attach ----------------------------------------------------------

# What a guest runs to be attached (a line saying so when it has no `agents` session): that session gets a window
# `dashboard`, workmux's dashboard (started again
# after each jump, which ends it), when it has none, swapped into the first place (window 0) when it isn't there; the
# attach opens on it when no one else is attached, so Enter on an agent goes to its window.
# Not `bash -l`: NixOS's /etc/profile resets PATH; workmux is in ~/.local/bin, off a non-login ssh's PATH.
attach_script() {
  cat <<'EOF'
# no agents session yet: said plainly, not tmux's "no server running" or "can't find session". fleet starts none:
# agent-methodology's launcher starts the server, with a clean environment for its panes
if ! tmux has-session -t =agents 2>/dev/null; then
  echo "no agents on $(hostname) yet: its tmux has no session agents (methodology next starts one)"; exit 1
fi
wm=$(command -v workmux || echo "$HOME/.local/bin/workmux")
if ! tmux list-windows -t =agents -F '#W' | grep -qx dashboard; then
  tmux new-window -d -t =agents: -n dashboard "while :; do $wm dashboard || sleep 5; done"
fi
first=$(tmux list-windows -t =agents -F '#{window_index}' 2>/dev/null | head -n 1)
[ -z "$first" ] || [ "$(tmux display -p -t =agents:dashboard '#{window_index}' 2>/dev/null)" = "$first" ] ||
  tmux swap-window -d -s =agents:dashboard -t "=agents:$first"
# on the dashboard, unless someone else is attached: the session's window is theirs too, and moving it moves their view
if [ -z "$(tmux list-clients -t =agents 2>/dev/null)" ]; then exec tmux -u attach -t =agents \; select-window -t =agents:dashboard; fi
exec tmux -u attach -t =agents
EOF
}

# The IP of guest $2 of host $1 (`-`: the host's first), now; nothing when it isn't known.
guest_ip() {
  local h g i
  while read -r h g i; do
    if [ "$h" = "$1" ] && [ "$g" != - ] && { [ "$2" = - ] || [ "$g" = "$2" ]; }; then echo "$i"; return; fi
  done < <(guests 2>/dev/null)
}

# Attach guest $2 of host $1 (`-`: the host's first; at IP $3 when the caller knows it) from this terminal: one tmux,
# the guest's (`-u`: a UTF-8 client whatever the ssh session's locale; tmux's own words when it can't). Returns when it
# ends; 1 when the guest isn't known now.
attach_guest() {
  local ip=${3:-}
  [ -n "$ip" ] || ip=$(guest_ip "$1" "$2")
  [ -n "$ip" ] || return 1
  ssh -t "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" "$(attach_script)"
}

# --- commands ------------------------------------------------------------

# The session: a window per guest, named after it (a host whose guests couldn't be read: a window named after the
# host, which finds its guest once the host answers). A session another layout built, or resurrect restored, is
# rebuilt (never from inside it, which would kill this fleet with it); one this layout built is left as it is.
cmd_up() {
  local s h g ip p n=0
  s=$(default_session)
  if tmx has-session -t "=$s" 2>/dev/null; then
    # The marker lives as long as the server: a session without it was
    # restored by resurrect into a new server, untagged, so rebuild it.
    [ "$(tmx show -gv "@fleet-booted-$s" 2>/dev/null)" != "$LAYOUT" ] || return 0
    [ -z "${TMUX:-}" ] || [ "$(tmx display -p '#S' 2>/dev/null)" != "$s" ] ||
      die "$s is from an older fleet and is rebuilt, which would end this pane: run fleet from another session, or detach first"
    tmx kill-session -t "=$s"
  fi
  echo "fleet: discovering guests..." >&2
  # shellcheck disable=SC2034 # ip: the attach looks it up itself, each time
  while read -r h g ip; do
    [ "$g" != - ] || g=''
    if [ "$n" = 0 ]; then
      p=$(tmx new-session -d -s "$s" -n "${g:-$h}" -x 200 -y 50 -P -F '#{pane_id}' "$(self_cmd _attach "$h" "${g:--}")") \
        || die "could not start tmux session $s"
    else
      p=$(tmx new-window -d -a -t "=$s:{end}" -n "${g:-$h}" -P -F '#{pane_id}' "$(self_cmd _attach "$h" "${g:--}")") || continue
    fi
    n=$((n + 1))
    tmx set -w -t "$p" @fleet-guest "${g:+$g · }$h"
  done < <(guests)
  [ "$n" -gt 0 ] || die "no guests: $(if [ "$LOCAL" = 1 ]; then echo "${AGENTVM_PROJECTS:-/etc/agentvm/projects.json} lists none"; else echo "$(hosts_file) names no host"; fi)"
  if [ "$LOCAL" = 1 ]; then tmx set -t "=$s:" @fleet-mode local; else tmx set -t "=$s:" @fleet-mode remote; fi
  tmx set -g "@fleet-booted-$s" "$LAYOUT"
}

cmd_doctor() {
  local fail=0 c dest h g ip err
  ok() { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }
  for c in tmux jq ssh; do
    if command -v "$c" >/dev/null; then ok "$c"; else bad "$c not on PATH"; fi
  done
  if [ "$LOCAL" = 0 ]; then
    if [ -r "$(hosts_file)" ]; then
      while read -r dest; do
        case $dest in ''|'#'*) continue ;; esac
        if ssh "${SSH_OPTS[@]}" "$dest" true </dev/null >/dev/null 2>&1; then ok "ssh $dest"; else bad "ssh $dest"; fi
      done < "$(hosts_file)"
    else
      bad "no hosts file $(hosts_file)"
    fi
  fi
  while read -r h g ip; do
    [ "$g" != - ] || continue
    if [ "$LOCAL" = 0 ]; then
      if ip route get "$ip" 2>/dev/null | grep -q tailscale; then ok "route to $ip via tailscale"
      else bad "no tailnet route to $ip ($g on $h): tailscale up --accept-routes"; fi
    fi
    if err=$(ssh "${GUEST_SSH_OPTS[@]}" "$GUEST_USER@$ip" command -v tmux </dev/null 2>&1 >/dev/null); then
      ok "ssh $GUEST_USER@$ip ($g): tmux"
    else
      bad "ssh $GUEST_USER@$ip ($g): no ssh, or no tmux there"
      [ -z "$err" ] || echo "      $(tail -n 1 <<<"$err")"   # ssh's own reason
    fi
  done < <(guests)
  return "$fail"
}

# Pane command (a guest's window): attach_guest, then again after a detach, a dropped link or no session, at Enter
# or in 15 s, the guest looked up again each time. There `C-b` is the guest's tmux (`C-b d` comes back here).
cmd__attach() {
  local host=$1 g=$2
  while :; do
    attach_guest "$host" "$g"
    echo "[fleet] $( [ "$g" = - ] && echo "$host" || echo "$g") not attached; Enter or 15 s attaches again"
    read -r -t 15 _ || true
  done
}

# fleet attach [GUEST]: that guest, or the only one, straight from this terminal (in a tmux pane, the guest's tmux
# nests in it); with several and none named, the fleet session.
# A host that didn't answer counts as a guest, so one down doesn't turn the laptop's session into a single attach.
cmd_attach() {
  local list host g ip
  list=$(guests)
  if [ -n "${1:-}" ]; then
    read -r host g ip < <(awk -v g="$1" '$2 == g { print; exit }' <<<"$list")
    [ -n "${host:-}" ] || die "no guest $1"
  elif [ "$(grep -c . <<<"$list")" = 1 ]; then
    read -r host g ip <<<"$list"
    [ "$g" != - ] || host=''   # its host down: the session, whose window attaches once it answers
  fi
  if [ -n "${host:-}" ]; then
    [ -z "${TMUX:-}" ] || echo "fleet: inside tmux, so $g's tmux nests in this one; from a terminal outside tmux it is one" >&2
    attach_guest "$host" "$g" "$ip"
    return
  fi
  cmd_up || exit 1
  if [ -n "${TMUX:-}" ]; then tmx switch-client -t "=$(default_session)"
  else exec tmux ${FLEET_TMUX_SOCKET:+-L "$FLEET_TMUX_SOCKET"} attach -t "=$(default_session)"; fi
}

usage() {
  cat <<'EOF'
usage: fleet [--local] [command]

  (none), attach [GUEST]
                that guest, or the only one, attached from this terminal; with
                several, the fleet session (a window per guest), started if needed
  up            start the fleet session if needed (no attach)
  ls            list guests: host guest ip
  doctor        check each prerequisite, name the one that fails
  help          this text

--local: this host's guests only (/etc/agentvm/projects.json), session fleet-<host>.
Hosts: ~/.config/fleet/hosts, one ssh destination per line (theo@nixos).
A guest's agents session opens on its window `dashboard` (workmux's): Enter on an
agent goes to it. C-b there is the guest's tmux, C-b w picks a window, C-b d detaches.
EOF
}

main() {
  if [ "${1:-}" = --local ]; then LOCAL=1; shift; fi
  guest_ssh_opts
  local cmd=${1:-attach}
  [ $# -eq 0 ] || shift
  case $cmd in
    attach) cmd_attach "$@" ;;
    up) cmd_up ;;
    _attach) cmd__attach "$@" ;;
    ls) guests ;;
    doctor) cmd_doctor ;;
    help|-h|--help) usage ;;
    _attach-script) attach_script ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
