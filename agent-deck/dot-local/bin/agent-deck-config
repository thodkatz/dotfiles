#!/usr/bin/env bash
# Build Agent Deck's config.toml from the two files next to it: settings.toml, the settings every machine shares
# (this package's), and remotes.toml, this machine's guests (the laptop's, this package's; a NixOS host's, written by
# nixed). Each key of settings.toml replaces the config's, the keys and tables deck wrote itself are kept (`launch`'s
# [claude] dangerous_mode, say), and every [remotes.*] is remotes.toml's, so a guest gone from it goes. A config
# already up to date is not rewritten: deck reloads the file when its mtime changes. fleet runs it before its deck
# window; `fleet doctor` runs --check.
#
# usage: agent-deck-config [--check] [config.toml]   (default $XDG_CONFIG_HOME/agent-deck/config.toml)
#   --check: changes nothing; 1, saying why, when the config is missing or out of date with the two sources.
# Exit 2 without settings.toml. Values are read a line at a time: a multi-line array of deck's own is not kept.
set -euo pipefail

check=0
[ "${1:-}" != --check ] || { check=1; shift; }
config=${1:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-deck/config.toml}
dir=$(dirname "$config")
settings=$dir/settings.toml remotes=$dir/remotes.toml
[ -r "$settings" ] || { echo "agent-deck-config: no $settings" >&2; exit 2; }

render() {
  local c=/dev/null r=/dev/null
  [ ! -r "$config" ] || c=$config
  [ ! -r "$remotes" ] || r=$remotes
  awk -v cfile="$c" -v sfile="$settings" -v rfile="$r" '
    # a table header'"'"'s name, "" for any other line
    function hdr(l,   n) {
      if (l !~ /^[ \t]*\[[^]]*\]\]?[ \t]*(#.*)?$/) return ""
      n = l; sub(/#.*/, "", n); gsub(/[ \t"'"'"']/, "", n); return n
    }
    function key(l,   k) {
      if (l !~ /^[ \t]*[^#= \t\[][^=]*=/) return ""
      k = l; sub(/=.*/, "", k); gsub(/[ \t"'"'"']/, "", k); return k
    }
    function remote(n) { return n ~ /^\[remotes\./ }
    function blank(l) { return l ~ /^[ \t]*(#.*)?$/ }
    # one blank line at most between two others, none first
    function out(l) { if (l == "" && last == "") return; print l; last = l }
    BEGIN {
      # the config: each table'"'"'s key lines, and the tables in their order, [remotes.*] dropped
      t = ""; nt = 0
      while ((getline l < cfile) > 0) {
        if ((h = hdr(l)) != "") { t = h; if (!(t in hline)) { hline[t] = l; order[++nt] = t }; continue }
        if (remote(t) || (k = key(l)) == "") continue
        ck[t, ++cn[t]] = k; cl[t, cn[t]] = l
      }
      # settings.toml: its tables and keys
      ns = 0; t = ""
      while ((getline l < sfile) > 0) {
        s[++ns] = l
        if ((h = hdr(l)) != "") { t = h; st[t] = 1 } else if ((k = key(l)) != "") sk[t, k] = 1
      }
      out("# Generated by agent-deck-config from settings.toml and remotes.toml, next to this file: edit those, not this.")
      # settings.toml as it is but its [remotes.*], each table followed by the config'"'"'s keys it lacks; the blank
      # and comment lines before a header stay with that header
      t = ""; nb = 0; skip = 0
      for (i = 1; i <= ns + 1; i++) {
        l = s[i]; h = (i > ns) ? "end" : hdr(l)
        if (h == "" && blank(l)) { buf[++nb] = l; continue }
        if (h != "") {
          if (!skip) for (j = 1; j <= cn[t]; j++) if (!((t, ck[t, j]) in sk)) out(cl[t, j])
          if (i > ns) { if (!skip) for (j = 1; j <= nb; j++) out(buf[j]); break }
          t = h; skip = remote(t)
        }
        if (!skip) { for (j = 1; j <= nb; j++) out(buf[j]); out(l) }
        nb = 0
      }
      # the config'"'"'s own tables
      for (i = 1; i <= nt; i++) {
        t = order[i]
        if (t == "" || (t in st) || remote(t) || !cn[t]) continue
        out(""); out(hline[t])
        for (j = 1; j <= cn[t]; j++) out(cl[t, j])
      }
      # remotes.toml'"'"'s [remotes.*], with the comments before each
      out(""); t = ""; nb = 0
      while ((getline l < rfile) > 0) {
        if ((h = hdr(l)) != "") t = h
        else if (blank(l)) { buf[++nb] = l; continue }
        if (remote(t)) { for (j = 1; j <= nb; j++) out(buf[j]); out(l) }
        nb = 0
      }
    }'
}

new=$(render)
if [ -r "$config" ] && [ "$(cat "$config")" = "$new" ]; then exit 0; fi
if [ "$check" = 1 ]; then
  if [ -e "$config" ]; then echo "$config is out of date with settings.toml and remotes.toml"; else echo "no $config"; fi
  exit 1
fi
tmp=$(mktemp "$dir/.config.toml.XXXXXX")
printf '%s\n' "$new" > "$tmp"
mv -f "$tmp" "$config"   # replaces a stowed link, never writes through it
