{
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "codesnap.showWindowControls": false,
  "codesnap.showLineNumbers": false,
  "codesnap.transparentBackground": true,
  "codesnap.boxShadow": "rgba(0, 0, 0, 0) 0px 0px 0px",
  "codesnap.backgroundColor": "#0000",
  "codesnap.containerPadding": "0em",
  "[python]": {
    "breadcrumbs.showConstructors": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "editor.minimap.enabled": false,
  "[octave]": {
    "editor.defaultFormatter": "tusindfryd.octave-formatter"
  },
  "jupyter.interactiveWindow.creationMode": "perFile",
  "jupyter.runStartupCommands": [
    "%load_ext autoreload",
    "%autoreload 2"
  ],
  "workbench.sideBar.location": "right",
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.iconTheme": "material-icon-theme",
  "window.menuBarVisibility": "toggle",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.tabSizingFixedMinWidth": 38,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.highlightModifiedTabs": true,
  "terminal.integrated.inheritEnv": false,
  "pylint.lintOnChange": true,
  "pylint.showNotifications": "always",
  "files.autoSave": "afterDelay",
  "workbench.activityBar.location": "top",
  "interactiveWindow.executeWithShiftEnter": true,
  "remote.SSH.configFile": "~/.ssh/config",
  // BEGIN remote.SSH.defaultExtensions (generated by sync-default-extensions.sh -- do not edit by hand)
  "remote.SSH.defaultExtensions": [
    "adpyke.codesnap",
    "affenwiesel.matlab-formatter",
    "akamud.vscode-theme-onedark",
    "analytic-signal.preview-pdf",
    "anthropic.claude-code",
    "arrterian.nix-env-selector",
    "batisteo.vscode-django",
    "charliermarsh.ruff",
    "donjayamanne.python-environment-manager",
    "donjayamanne.python-extension-pack",
    "foam.foam-vscode",
    "gimly81.matlab",
    "github.github-vscode-theme",
    "github.vscode-github-actions",
    "hyzeta.vscode-theme-github-light",
    "james-yu.latex-workshop",
    "jdinhlife.gruvbox",
    "jnoortheen.nix-ide",
    "kamikillerto.vscode-colorize",
    "kevinrose.vsc-python-indent",
    "mechatroner.rainbow-csv",
    "mkhl.direnv",
    "ms-azuretools.vscode-containers",
    "ms-azuretools.vscode-docker",
    "ms-dotnettools.vscode-dotnet-runtime",
    "ms-mssql.data-workspace-vscode",
    "ms-mssql.mssql",
    "ms-mssql.sql-bindings-vscode",
    "ms-mssql.sql-database-projects-vscode",
    "ms-python.black-formatter",
    "ms-python.debugpy",
    "ms-python.flake8",
    "ms-python.isort",
    "ms-python.mypy-type-checker",
    "ms-python.pylint",
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.vscode-python-envs",
    "ms-toolsai.jupyter",
    "ms-toolsai.jupyter-keymap",
    "ms-toolsai.jupyter-renderers",
    "ms-toolsai.vscode-jupyter-slideshow",
    "ms-vscode-remote.remote-containers",
    "ms-vscode-remote.remote-ssh",
    "ms-vscode-remote.remote-ssh-edit",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpp-devtools",
    "ms-vscode.cpptools",
    "ms-vscode.cpptools-extension-pack",
    "ms-vscode.cpptools-themes",
    "ms-vscode.makefile-tools",
    "ms-vscode.remote-explorer",
    "ms-vscode.remote-server",
    "mtxr.sqltools",
    "njpwerner.autodocstring",
    "njqdev.vscode-python-typehint",
    "openai.chatgpt",
    "pinage404.nix-extension-pack",
    "pkief.material-icon-theme",
    "pnp.polacode",
    "redhat.vscode-yaml",
    "reditorsupport.r",
    "reditorsupport.r-syntax",
    "seanwu.vscode-qt-for-python",
    "shd101wyy.markdown-preview-enhanced",
    "svelte.svelte-vscode",
    "tamasfe.even-better-toml",
    "tomoki1207.pdf",
    "twxs.cmake",
    "valentjn.vscode-ltex",
    "visualstudioexptteam.intellicode-api-usage-examples",
    "vscodevim.vim",
    "wholroyd.jinja",
    "xaver.clang-format",
    "yzane.markdown-pdf",
    "zamerick.vscode-caddyfile-syntax"
  ],
  // END remote.SSH.defaultExtensions
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.inlayHints.callArgumentNames": "all",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.envFile": "${workspaceFolder}/.env",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.env.linux": {
    "CUDA_VISIBLE_DEVICES": "5"
  },
  "ruff.nativeServer": "on",
  "ruff.lint.preview": true,
  "ruff.trace.server": "messages",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.build.forceRecipeUsage": false,
  "latex-workshop.latex.recipe.default": "xelatex",
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex",
      "tools": [
        "xelatex"
      ]
    },
    {
      "name": "pdflatex",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatexbib",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "xelatexglss",
      "tools": [
        "xelatex",
        "makeglossaries",
        "xelatex",
        "xelatex"
      ]
    },
    {
      "name": "xelatexbib",
      "tools": [
        "xelatex",
        "bibtex",
        "xelatex",
        "xelatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "%DOC%"
      ]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "--shell-escape",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "makeglossaries",
      "command": "makeglossaries",
      "args": [
        "%DOCFILE%"
      ]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DOCFILE%"
      ]
    }
  ],
  "debug.showVariableTypes": true,
  "jupyter.showVariableViewWhenDebugging": true,
  "debugpy.showPythonInlineValues": true,
  "debug.inlineValues": "on",
  "makefile.configureOnOpen": true,
  "jupyter.debugJustMyCode": false,
  "debugpy.debugJustMyCode": false,
  "latex-workshop.formatting.latex": "latexindent",
  "github-actions.remote-name": "upstream",
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "remote.SSH.connectTimeout": 180,
  "ltex.enabled": [
    "latex",
    "markdown",
    "plaintext"
  ],
  "ltex.additionalRules.motherTongue": "en-US",
  "ltex.language": "en-US",
  "ltex.statusBarItem": true,
  "ltex.additionalRules.enablePickyRules": true,
  "ltex.languageToolHttpServerUri": "http://localhost:8081",
  "ltex.disabledRules": {
    "en-US": [
      "TOO_LONG_SENTENCE"
    ],
    "el-GR": [
      "TOO_LONG_SENTENCE"
    ]
  },
  "chat.extensionUnification.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "diffEditor.maxComputationTime": 0,
  "vim.handleKeys": {
    "<C-f>": false,
    "<C-o>": false,
    "<C-a>": false,
    "<C-p>": false,
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-n>"
      ],
      "commands": [
        ":nohl"
      ]
    },
  ],
  // To improve performance
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useCtrlKeys": true,
  "isort.showNotifications": "onError",
  "python.languageServer": "Jedi",
  "claudeCode.selectedModel": "default",
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ROOT"
    }
  ],
  "mssql.connections": [
    {
      "authenticationType": "SqlLogin",
      "connectTimeout": 30,
      "applicationName": "vscode-mssql",
      "applicationIntent": "ReadWrite",
      "server": "localhost,1433",
      "database": "",
      "user": "sa",
      "password": "",
      "commandTimeout": 30,
      "encrypt": "Mandatory",
      "groupId": "ROOT",
      "profileName": "mssql-local",
      "trustServerCertificate": true,
      "id": "b9339530-8505-4bde-848c-65f4d02d72bf",
      "containerName": "mssql"
    }
  ],
  "mssql.openQueryResultsInTabByDefault": true,
  "mssql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
  "nix.enableLanguageServer": true,
  "editor.largeFileOptimizations": false,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "yaml.schemas": {
    "file:///home/thodkatz/.vscode/extensions/continue.continue-2.0.0-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  }
}
