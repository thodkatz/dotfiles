#!/bin/bash
#
# ~/.xinitrc
#
# Executed by startx (run your window manager from here)
#
#

systemctl --user import-environment DISPLAY XAUTHORITY
gpg-agent --daemon
sxhkd -c ~/.config/sxhkd/media-keys &   # volume and brightness keys
dex --autostart --environment dwm

# set the screen layout before dwm starts, so it sees the final monitors and never has to migrate windows off a
# screen that disappears: screen-layout (scripts package) picks it from what is plugged in. Called by its path in
# this checkout when ~/.local/bin doesn't have it yet (scripts not re-stowed)
layout=$HOME/.local/bin/screen-layout
[[ -x $layout ]] || layout="$(dirname "$(readlink -f "$HOME/.xinitrc")")/../scripts/dot-local/bin/screen-layout"
"$layout"

exec dwm
