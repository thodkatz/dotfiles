#!/usr/bin/env bash
# Stub ssh for tests/fleet.bats: answers from $FLEET_FIXTURES by destination
# and command, and logs every call to $FLEET_FIXTURES/ssh.log.
fx=$FLEET_FIXTURES
echo "ssh $*" >> "$fx/ssh.log"
G=
while [ $# -gt 0 ]; do
  case $1 in -o|-i) shift 2 ;; -t|-T) shift ;; -G) G=1; shift ;; *) break ;; esac
done
dest=${1#*@}; shift
# ssh -G: the config for a destination; fleet reads its hostname
[ -z "$G" ] || { echo "user agentvm"; echo "hostname $dest"; exit 0; }
cmd="$*"
[ ! -e "$fx/fail-$dest" ] || { echo "ssh: connect to host $dest port 22: Connection timed out" >&2; exit 255; }
case $cmd in
  'cat /etc/agentvm/projects.json') [ ! -e "$fx/slow-$dest" ] || sleep 2; cat "$fx/projects-$dest.json" ;;
  'bash -s -- json'|'bash -s -- table')
    cat >/dev/null
    [ ! -e "$fx/hang-$dest" ] || exec sleep 600
    if [ -e "$fx/nosup-$dest" ]; then echo fleet:no-supervisor
    elif [ "$cmd" = 'bash -s -- json' ]; then cat "$fx/guest-$dest.json"
    else echo "table of $dest"; fi ;;
  'bash -s -- inbox-json')
    # what the probe script's inbox-json mode prints: the guest's inbox items not closed, a line per key, then
    # status.sh's JSON (or the no-supervisor marker)
    cat >/dev/null
    [ ! -e "$fx/hang-$dest" ] || exec sleep 600
    echo fleet:inbox
    for f in "$fx/inbox-$dest"/[0-9]*; do
      [ -f "$f" ] && ! grep -qx state=closed "$f" && sed "s/^/${f##*/}\t/" "$f"
    done
    echo fleet:status
    if [ -e "$fx/nosup-$dest" ]; then echo fleet:no-supervisor; else cat "$fx/guest-$dest.json"; fi ;;
  'dtach -a '*)
    [ ! -e "$fx/attach-lost" ] || exit 255
    [ -e "$fx/attach-exits" ] && exit 0; exec sleep 600 ;;
  *btop*) exec sleep 600 ;;
  'test -S '*) [ -e "$fx/sock-alive" ] ;;
  true|'command -v dtach') exit 0 ;;
  *) echo "stub ssh: unexpected command: $cmd" >&2; exit 1 ;;
esac
